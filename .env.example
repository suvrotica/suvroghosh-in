# Existing site integrations
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Match Vercel Production and the GitHub Actions INDEXNOW_KEY secret; redeploy after changes.
INDEXNOW_KEY=
CHATTERBOX_TTS_API_KEY=
CHATTERBOX_TTS_ENDPOINT=
CHATTERBOX_TTS_DEFAULT_MODEL=
CHATTERBOX_TTS_DEFAULT_VOICE=
# Visitor-readable experimental UI flag, currently read through $env/dynamic/public.
# This only displays controls; it does not authorize requests to the speech endpoint.
PUBLIC_ENABLE_CHATTERBOX_TTS=false

# Article narration: authoring scripts only; never sent to visitors or needed by builds.
# Use a Gemini Developer API project on the Free tier with billing disabled.
GEMINI_API_KEY=
# Explicit operator confirmation of the project's tier; not an API billing check.
# Keep false until the project's Free tier has been verified in Google AI Studio.
GEMINI_TTS_FREE_TIER_CONFIRMED=false
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Exact voice ID from the verified en-US/American prebuilt catalogue.
# Defaults to Achird; no voice cloning or paid fallback.
GEMINI_TTS_VOICE=achird
# Optional local encoder path for narration:compress; never needed by site builds or Vercel.
# The compressor also checks .codex-artifacts/narration-tools/node_modules/ffmpeg-static.
FFMPEG_PATH=

# Handwritten notes (server-only; never prefix these with PUBLIC_)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NOTES_OWNER_USER_ID=
# Generate at least 32 random bytes. Used for login throttles and rotating comment-abuse HMACs.
NOTES_RATE_LIMIT_SALT=
