# Existing site integrations
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Comment alerts reuse the contact sender/recipient above; dispatch runs only in Vercel Production.
# Generate at least 32 random bytes. Match the private Supabase Vault scheduler secret.
COMMENTS_NOTIFICATION_SECRET=
# Match Vercel Production and the GitHub Actions INDEXNOW_KEY secret; redeploy after changes.
INDEXNOW_KEY=
CHATTERBOX_TTS_API_KEY=
CHATTERBOX_TTS_ENDPOINT=
CHATTERBOX_TTS_DEFAULT_MODEL=
CHATTERBOX_TTS_DEFAULT_VOICE=
# Public TTS remains unavailable until the private switch, dedicated salt, existing
# Supabase service credentials and 202610280001_chatterbox_usage.sql are configured.
# Shared hard ceilings: 100 calls and 60,000 text characters/UTC day, 3/client/hour,
# and 2 starts per 150 seconds. Failed/aborted calls consume quota; no automatic retries.
# These are resource limits, not a provider monetary cap: confirm backend billing separately.
CHATTERBOX_TTS_ENABLED=false
# Generate a dedicated secret of at least 32 random characters; never use PUBLIC_.
CHATTERBOX_TTS_RATE_LIMIT_SALT=
# Visitor-readable experimental UI flag, currently read through $env/dynamic/public.
# This only displays controls; it does not authorize requests to the speech endpoint.
PUBLIC_ENABLE_CHATTERBOX_TTS=false

# Article narration: authoring scripts only; never sent to visitors or needed by builds.
# Use a Gemini Developer API project on the Free tier with billing disabled.
GEMINI_API_KEY=
# Explicit operator confirmation of the project's tier; not an API billing check.
# Keep false until the project's Free tier has been verified in Google AI Studio.
GEMINI_TTS_FREE_TIER_CONFIRMED=false
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Exact voice ID from the verified en-US/American prebuilt catalogue.
# Defaults to Achird; no voice cloning or paid fallback.
GEMINI_TTS_VOICE=achird
# Optional local encoder path for narration:compress; never needed by site builds or Vercel.
# The compressor also checks .codex-artifacts/narration-tools/node_modules/ffmpeg-static.
FFMPEG_PATH=

# Handwritten notes (server-only; never prefix these with PUBLIC_)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NOTES_OWNER_USER_ID=
# Generate at least 32 random bytes. Used for login throttles and rotating comment-abuse HMACs.
NOTES_RATE_LIMIT_SALT=

# Prompt Atlas optional semantic mode (server-only). Local mode needs none of these.
# The model is fixed in code to nvidia/nemotron-3.5-lightning-free, NVIDIA only.
# A live zero-price check runs before each generation. No paid fallback or credit purchases.
# NVIDIA may retain prompts/responses for model improvement; UI requires per-request consent.
# Enable only after applying 202610250001_prompt_atlas_usage.sql to the shared Supabase project.
PROMPT_ATLAS_AI_ENABLED=false
# Mindmap Studio reuses this free-only switch, provider credentials and the SAME
# shared 50/day + 5/client/hour quota pool. It adds no paid fallback or new secrets.
# Generate a dedicated secret of at least 32 random bytes for rotating HMAC quota keys.
PROMPT_ATLAS_RATE_LIMIT_SALT=
# Vercel deployments use automatically injected VERCEL_OIDC_TOKEN. Optional local key:
AI_GATEWAY_API_KEY=

# Post to UML optional owner-only AI mode (server-only). Local heuristic/manual mode needs none.
# Requires its own explicit flag; never inherits Prompt Atlas enablement. Disabled on Vercel previews.
# Reuses AI_GATEWAY_API_KEY or VERCEL_OIDC_TOKEN and the configured Notes owner login above.
# Requires SUPABASE_SERVICE_ROLE_KEY and 202610250001_prompt_atlas_usage.sql.
# Shares Prompt Atlas's atomic 50-request UTC daily pool, plus 5 UML requests per owner/hour.
# No SDK retries; failed provider calls consume reservations. Request limits are not currency caps.
# Set a provider-side spending cap before choosing a paid model. Never use PUBLIC_ credentials.
# AI input is limited to 40,000 code points; larger input is rejected, never silently truncated.
UML_AI_ENABLED=false
UML_AI_MODEL=nvidia/nemotron-3.5-lightning-free
# Generate at least 32 random characters. PROMPT_ATLAS_RATE_LIMIT_SALT is a fallback.
UML_RATE_LIMIT_SALT=

# Synthetic Data Lab frontend: private SvelteKit-to-Python connection; never use PUBLIC_.
# Local launcher supplies URL/token to child processes without writing a secret file.
SYNTHETIC_DATA_API_URL=
# At least 24 random characters, matching the Python service environment.
SYNTHETIC_DATA_SERVICE_TOKEN=
# Optional Vercel Deployment Protection automation bypass for the private Python deployment.
# Sent only by the SvelteKit server as x-vercel-protection-bypass; never sent to visitors.
SYNTHETIC_DATA_DEPLOYMENT_BYPASS=
# Explicit local production-preview opt-in. Only loopback HTTP is permitted by this flag.
# Keep false for hosted connections, which must use HTTPS.
SYNTHETIC_DATA_ALLOW_LOOPBACK=false

# Synthetic Data Lab Python project only: set these in its private host environment.
# Hosted mode is blob (also selected automatically when VERCEL=1). Local default is memory.
# For a long-lived local/container service, explicitly use memory and one ASGI worker.
SYNTHETIC_DATA_STORAGE_MODE=blob
# At least 24 random characters; Vercel Cron sends this bearer secret to /cleanup.
CRON_SECRET=
# Dedicated shared admission/job/idempotency metadata; HTTPS endpoint required.
# Marketplace's KV_REST_API_URL / KV_REST_API_TOKEN names are accepted aliases.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Connect a private Blob store. On Vercel, BLOB_STORE_ID + injected VERCEL_OIDC_TOKEN
# authorize access; a scoped read/write token is the alternative for local hosted-mode checks.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Customer enquiry prototype (all server-only; never expose as PUBLIC_ variables).
# Production uses private Supabase visitor snapshots, not local SQLite files.
ENQUIRY_DEMO_PUBLIC_ENABLED=0
# >=32 random characters; must match the protected Supabase Vault cron secret.
ENQUIRY_DEMO_WORKER_SECRET=
# Local-only legacy mode, supplied by enquiry-demo:dev.
ENQUIRY_DEMO_ENABLED=0
ENQUIRY_DEMO_DB=
ENQUIRY_DEMO_PASSWORD=
# Tests only. Ignored on Vercel; never enable for a hosted database URL.
ENQUIRY_DEMO_ALLOW_TEST_BACKEND=0
