# Local credentials, generation caches and native authoring tools are never uploaded.
.env
.env.local
.env.*.local
.codex/
.codex-artifacts/
.audit-private/
.codex-artifacts-*.log
services/synthetic-data-lab/.agents/
services/synthetic-data-lab/skills-lock.json
services/synthetic-data-lab/.pytest_cache/

# Publish only complete, compressed narration assets.
static/audio/articles/**/*.wav
static/audio/articles/*/*.json
!static/audio/articles/*/manifest.json
static/audio/articles/_audition/
