{
	"name": "suvroghosh-in",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		}
	},
	"scripts": {
		"predev": "npm run sketches:generate",
		"dev": "vite dev",
		"tags:generate": "node scripts/generate-post-tags.mjs",
		"tags:test": "node --test scripts/generate-post-tags.test.mjs",
		"bengali:test": "node --test scripts/rehype-bengali-lang.test.mjs",
		"visualizations:test": "node --test scripts/visualizations.test.mjs",
		"artificial-life:test": "node --test scripts/artificial-life.test.mjs",
		"monte-carlo:test": "node --test scripts/monte-carlo.test.mjs",
		"living-pigment:test": "node --test scripts/living-pigment.test.mjs",
		"invisible-weather:test": "vitest run src/lib/visualizations/invisible-weather",
		"invisible-weather:browser:test": "playwright test --config=playwright.invisible-weather.config.ts",
		"invisible-weather:poster": "node scripts/render-invisible-weather-poster.mjs",
		"neuron-zoo:test": "vitest run src/lib/visualizations/neuron-zoo",
		"ct-reconstruction:test": "vitest run src/lib/visualizations/ct-reconstruction",
		"city-master-plan:test": "vitest run src/lib/visualizations/city-master-plan",
		"bias-archipelago:data:validate": "node --experimental-strip-types scripts/validate-bias-data.ts",
		"bias-archipelago:sources:check": "node --experimental-strip-types scripts/generate-bias-sources.ts --check",
		"bias-archipelago:layout": "node --experimental-strip-types scripts/generate-bias-layout.ts",
		"bias-archipelago:layout:check": "node --experimental-strip-types scripts/generate-bias-layout.ts --check",
		"bias-archipelago:test": "npm run bias-archipelago:data:validate && npm run bias-archipelago:sources:check && npm run bias-archipelago:layout:check && vitest run src/lib/visualizations/bias-archipelago",
		"bias-archipelago:browser:test": "playwright test --config=playwright.bias-archipelago.config.ts",
		"city-master-plan:stress": "vitest run --config vitest.city-master-plan-stress.config.ts",
		"city-master-plan:browser:test": "playwright test --config=playwright.city-master-plan.config.ts",
		"fractal-atlas:test": "vitest run src/lib/visualizations/fractal-atlas",
		"gradient-descent:test": "vitest run src/lib/visualizations/gradient-descent",
		"gradient-descent:browser:test": "playwright test --config=playwright.gradient-descent.config.ts",
		"gradient-descent:poster": "node scripts/render-gradient-descent-landscapes-poster.mjs",
		"double-pendulum:test": "vitest run src/lib/visualizations/double-pendulum",
		"double-pendulum:browser:test": "playwright test --config=playwright.double-pendulum.config.ts",
		"brownian-motion:test": "vitest run src/lib/visualizations/brownian-motion",
		"brownian-motion:browser:test": "playwright test --config=playwright.brownian-motion.config.ts",
		"lightning-atlas:test": "vitest run src/lib/visualizations/lightning-atlas",
		"reaction-diffusion:test": "vitest run src/lib/visualizations/reaction-diffusion",
		"reaction-diffusion:browser:test": "playwright test --config=playwright.reaction-diffusion.config.ts",
		"reaction-diffusion:poster": "node scripts/render-reaction-diffusion-atlas.mjs",
		"reaction-diffusion:calibrate-presets": "node scripts/calibrate-reaction-diffusion-presets.mjs",
		"bz-laboratory:test": "vitest run src/lib/visualizations/bz",
		"bz-laboratory:browser:test": "playwright test --config=playwright.bz-laboratory.config.ts",
		"bz-laboratory:poster": "node scripts/render-bz-laboratory.mjs",
		"bz-laboratory:calibrate": "node scripts/calibrate-bz-presets.mjs",
		"lightning-atlas:browser:test": "playwright test --config=playwright.lightning-atlas.config.ts",
		"lightning-atlas:poster": "node scripts/render-lightning-atlas-poster.mjs",
		"fractal-atlas:browser:test": "playwright test --config=playwright.fractal-atlas.config.ts",
		"fractal-atlas:poster": "node scripts/render-fractal-atlas-poster.mjs",
		"fractal-atlas:presets": "node scripts/render-fractal-atlas-presets.mjs",
		"fractal-atlas:figures": "node scripts/render-fractal-atlas-figures.mjs",
		"fractal-atlas:captures": "node scripts/capture-fractal-atlas.mjs",
		"city-master-plan:poster": "node scripts/render-city-master-plan-poster.mjs",
		"ct-laboratory:test": "node --test scripts/ct-reconstruction-laboratory.test.mjs",
		"ct-responsive:test": "playwright test --config=playwright.ct.config.ts",
		"motion:unit:test": "vitest run src/lib/motion",
		"motion:browser:test": "playwright test --config=playwright.motion.config.ts",
		"spacetime:test": "node --test scripts/spacetime-laboratory.test.mjs && node --experimental-strip-types --test scripts/spacetime-physics.test.mjs",
		"post-images:test": "node --experimental-strip-types --test scripts/post-image-metadata.test.mjs scripts/image-metadata.test.mjs",
		"resources:test": "node --experimental-strip-types --test scripts/resources.test.mjs",
		"resources:browser:test": "playwright test --config=playwright.resources.config.ts",
		"resources:images": "node scripts/generate-resource-images.mjs",
		"indexnow:test": "node --test scripts/indexnow.test.mjs",
		"notes:sql:test": "node --test scripts/handwritten-notes-migration.test.mjs",
		"notes:test": "vitest run && npm run notes:sql:test",
		"sketches:test": "node --test scripts/sketch-manifest.test.mjs && vitest run src/lib/components/sketch-museum",
		"test": "npm run tags:test && npm run bengali:test && npm run post-images:test && npm run resources:test && npm run sketches:test && npm run visualizations:test && npm run reaction-diffusion:test && npm run bz-laboratory:test && npm run artificial-life:test && npm run monte-carlo:test && npm run living-pigment:test && npm run spacetime:test && npm run ct-laboratory:test && npm run indexnow:test && npm run notes:test",
		"music:generate": "node scripts/generate-music-posts.mjs",
		"images:optimize": "python scripts/optimize_images.py",
		"gallery:generate": "node scripts/generate-media-gallery.mjs",
		"sketches:generate": "node scripts/generate-sketch-manifest.mjs",
		"sketches:verify": "node scripts/generate-sketch-manifest.mjs --verify",
		"images:verify": "python scripts/optimize_images.py --verify",
		"images:install": "python -m pip install --user -r requirements-images.txt",
		"wordclouds": "python scripts/generate_wordclouds.py",
		"wordclouds:install": "python -m pip install --user -r requirements-wordcloud.txt",
		"notebooks:install": "python -m pip install --user -r requirements-notebooks.txt",
		"notebooks:lab": "python -m jupyterlab --notebook-dir=src/lib/notebooks",
		"notebooks:render": "python scripts/render_notebooks.py",
		"notebooks:verify": "python scripts/render_notebooks.py --check",
		"content:generate": "npm run tags:generate && npm run music:generate && npm run images:optimize && npm run sketches:generate && npm run gallery:generate && python scripts/prebuild_wordclouds.py && python scripts/prebuild_notebooks.py",
		"prebuild": "npm run bias-archipelago:data:validate && npm run bias-archipelago:sources:check && npm run bias-archipelago:layout:check && npm run content:generate && npm run validate:content && npm run validate:resources && npm run validate:contrast && npm run validate:seo && npm run validate:media && npm run search:index && npm run validate:links",
		"build:site": "vite build",
		"build": "npm run build:site && npm run validate:discoverability",
		"search:index": "node scripts/build-search-index.mjs",
		"indexnow:submit": "node scripts/indexnow.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"validate:seo": "node scripts/validate-seo.mjs",
		"validate:content": "node scripts/validate-content.mjs",
		"validate:resources": "node scripts/validate-resources.mjs",
		"validate:contrast": "node scripts/validate-contrast.mjs",
		"validate:media": "node scripts/validate-media.mjs",
		"validate:links": "node scripts/validate-links.mjs",
		"validate:discoverability": "node scripts/validate-discoverability.mjs",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-vercel": "^6.3.1",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/d3": "^7.4.3",
		"@types/node": "^24",
		"@types/three": "^0.180.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"katex": "^0.16.44",
		"mdsvex": "^0.12.7",
		"pagefind": "^1.5.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-katex-svelte": "^1.2.0",
		"rehype-slug": "^6.0.0",
		"remark-math": "^3.0.0",
		"schema-dts": "^2.0.0",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.10",
		"yaml": "^2.9.0"
	},
	"dependencies": {
		"@fontsource-variable/noto-serif-bengali": "^5.3.0",
		"@fontsource-variable/roboto": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"@fontsource/courier-prime": "^5.3.0",
		"@observablehq/runtime": "^6.0.0",
		"@supabase/ssr": "^0.12.3",
		"@supabase/supabase-js": "^2.110.8",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"d3": "^7.9.0",
		"decimal.js": "^10.6.0",
		"dexie": "^4.4.4",
		"jspdf": "^4.2.1",
		"p5": "^2.3.0",
		"perfect-freehand": "^1.2.3",
		"resend": "^6.14.0",
		"sharp": "^0.35.3",
		"three": "^0.180.0",
		"zod": "^4.4.3"
	}
}
