{
	"name": "suvroghosh-in",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"tags:generate": "node scripts/generate-post-tags.mjs",
		"tags:test": "node --test scripts/generate-post-tags.test.mjs",
		"visualizations:test": "node --test scripts/visualizations.test.mjs",
		"artificial-life:test": "node --test scripts/artificial-life.test.mjs",
		"monte-carlo:test": "node --test scripts/monte-carlo.test.mjs",
		"living-pigment:test": "node --test scripts/living-pigment.test.mjs",
		"test": "npm run tags:test && npm run visualizations:test && npm run artificial-life:test && npm run monte-carlo:test && npm run living-pigment:test",
		"music:generate": "node scripts/generate-music-posts.mjs",
		"images:optimize": "python scripts/optimize_images.py",
		"gallery:generate": "node scripts/generate-media-gallery.mjs",
		"images:verify": "python scripts/optimize_images.py --verify",
		"images:install": "python -m pip install --user -r requirements-images.txt",
		"wordclouds": "python scripts/generate_wordclouds.py",
		"wordclouds:install": "python -m pip install --user -r requirements-wordcloud.txt",
		"notebooks:install": "python -m pip install --user -r requirements-notebooks.txt",
		"notebooks:lab": "python -m jupyterlab --notebook-dir=src/lib/notebooks",
		"notebooks:render": "python scripts/render_notebooks.py",
		"notebooks:verify": "python scripts/render_notebooks.py --check",
		"content:generate": "npm run tags:generate && npm run music:generate && npm run images:optimize && npm run gallery:generate && python scripts/prebuild_wordclouds.py && python scripts/prebuild_notebooks.py",
		"prebuild": "npm run content:generate && npm run validate:content && npm run validate:seo && npm run validate:media && npm run search:index && npm run validate:links",
		"build:site": "vite build",
		"build": "npm run build:site && npm run validate:discoverability",
		"search:index": "node scripts/build-search-index.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"validate:seo": "node scripts/validate-seo.mjs",
		"validate:content": "node scripts/validate-content.mjs",
		"validate:media": "node scripts/validate-media.mjs",
		"validate:links": "node scripts/validate-links.mjs",
		"validate:discoverability": "node scripts/validate-discoverability.mjs",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-vercel": "^6.3.1",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/d3": "^7.4.3",
		"@types/node": "^24",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"katex": "^0.16.44",
		"mdsvex": "^0.12.7",
		"pagefind": "^1.5.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-katex-svelte": "^1.2.0",
		"rehype-slug": "^6.0.0",
		"remark-math": "^3.0.0",
		"schema-dts": "^2.0.0",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^7.3.1",
		"yaml": "^2.9.0"
	},
	"dependencies": {
		"@fontsource-variable/roboto": "^5.2.10",
		"@observablehq/runtime": "^6.0.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"d3": "^7.9.0",
		"p5": "^2.3.0",
		"resend": "^6.14.0"
	}
}
