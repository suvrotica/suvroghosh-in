{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"redirects": [
		{
			"source": "/(.*)",
			"destination": "https://www.suvroghosh.in/$1",
			"statusCode": 301,
			"has": [
				{
					"type": "host",
					"value": "suvroghosh.in"
				}
			]
		}
	],
	"headers": [
		{
			"source": "/notebooks/perceptron-from-scratch-in-mojo.html",
			"headers": [
				{
					"key": "Link",
					"value": "<https://www.suvroghosh.in/blog/mojollm/perceptron-from-scratch-in-mojo>; rel=\"canonical\""
				}
			]
		},
		{
			"source": "/notebooks/xor-with-multiple-perceptrons-in-mojo.html",
			"headers": [
				{
					"key": "Link",
					"value": "<https://www.suvroghosh.in/blog/mojollm/xor-with-multiple-perceptrons-in-mojo>; rel=\"canonical\""
				}
			]
		},
		{
			"source": "/(.*)",
			"headers": [
				{ "key": "X-Frame-Options", "value": "DENY" },
				{ "key": "X-Content-Type-Options", "value": "nosniff" },
				{ "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
				{ "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
			]
		},
		{
			"source": "/audio/articles/:slug/manifest.json",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
		},
		{
			"source": "/audio/articles/:slug/:revision.mp3",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
		},
		{
			"source": "/(images|photos|sketch|videos|fonts)/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
		},
		{
			"source": "/(thumbnail|wordcloud|notebooks)/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=86400"
				}
			]
		}
	]
}
